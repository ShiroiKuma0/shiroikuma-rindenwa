<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the icon inside an in-call control. Yellow, like every other icon in the
     app; upstream drew them white, which was the last white left on the call screens. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/sk_ink_ghost" />
    <item android:state_pressed="true" android:color="@color/sk_black" />
    <item android:state_hovered="true" android:color="@color/sk_black" />
    <item android:color="@color/sk_yellow"/>
</selector>
