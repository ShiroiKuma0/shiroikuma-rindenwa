<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the circle behind an in-call control. It stays dark and lets the yellow icon
     carry the button; pressing it fills yellow, which is why the icon tint inverts to black. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/sk_disabled" />
    <item android:state_pressed="true" android:color="@color/sk_yellow" />
    <item android:state_hovered="true" android:color="@color/sk_yellow" />
    <item android:color="@color/sk_surface_raised"/>
</selector>
