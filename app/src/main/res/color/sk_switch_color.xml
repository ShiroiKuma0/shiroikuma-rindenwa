<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the two colours of a switch — the accent when on, a darker, opaque yellow
     (#8C8C00, never a faded one) when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/sk_yellow" />
    <item android:color="#FF8C8C00" />
</selector>
