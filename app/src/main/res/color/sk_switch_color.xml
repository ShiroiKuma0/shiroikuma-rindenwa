<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the two colours of a switch or a selection mark, by role — the names are
     fed from the role table at run time (SkPalette); no colour is written here. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/sk_switch_on" />
    <item android:color="@color/sk_switch_off" />
</selector>
