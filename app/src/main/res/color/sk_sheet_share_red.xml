<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the icon of a call-sheet control, coloured by what the control does (the
     "share" role of the menu icons); while the control is on it takes the colour of its ring.
     Every name is a role fed at run time (SkPalette). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/sk_ink_ghost" />
    <item android:state_selected="true" android:color="?attr/color_danger_500" />
    <item android:color="@color/sk_role_share" />
</selector>
