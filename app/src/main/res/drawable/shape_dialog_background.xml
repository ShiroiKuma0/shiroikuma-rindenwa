<?xml version="1.0" encoding="utf-8"?>
<!--
  shiroikuma-rindenwa fork — dialog panel.

  Upstream stacks two rounded rectangles offset by 2dp, which paints an accent line along the
  bottom edge only. On a black panel that reads as a stray underline rather than a frame, so the
  fork strokes the whole shape instead: every dialog is a black panel with a yellow border.
-->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="15dp" />
    <solid android:color="?attr/color_main2_000" />
    <stroke
        android:width="2dp"
        android:color="?attr/color_main1_500" />
</shape>
