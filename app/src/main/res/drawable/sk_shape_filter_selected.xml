<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the chosen segment of the call-history filter (upstream's "All calls /
     Missed", 2026-10-13). Upstream fills it with the accent and writes the label in white, which
     on this fork's palette is white on yellow — illegible, and against the house rule that a
     pressable thing is outlined and never filled. So the selection is marked the way an accent
     chip is: the thin 1.25dp frame of every other pill, over the yellow wash kept for tinted
     roles, with the label in full ink while the unselected one stays dim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="@color/sk_yellow_wash" />
    <stroke android:width="1.25dp" android:color="?attr/color_main1_500" />
</shape>
