<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: field pills carry a yellow border. Upstream strokes this with
     ?attr/color_grey_200, which is invisible against the black surface of this fork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="63dp" />
    <solid android:color="?attr/color_text_field_background"/>
    <stroke android:width="1.5dp" android:color="@color/sk_field_border" />
</shape>
