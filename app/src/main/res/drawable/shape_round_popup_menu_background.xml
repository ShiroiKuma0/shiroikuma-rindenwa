<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the frame of a menu — black, with the 2 dp yellow edge and 8 dp corners the
     sister dialer's popups have. Without it a menu has no edge against the black list behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="@color/sk_surface" />
    <stroke android:width="2dp" android:color="@color/sk_yellow" />
</shape>
