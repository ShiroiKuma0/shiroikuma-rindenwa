<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="android.view.View" />
        <variable
            name="addToContactsListener"
            type="View.OnClickListener" />
        <variable
            name="goToContactClickListener"
            type="View.OnClickListener" />
        <variable
            name="copyNumberClickListener"
            type="View.OnClickListener" />
        <variable
            name="deleteClickListener"
            type="View.OnClickListener" />
        <variable
            name="callClickListener"
            type="View.OnClickListener" />
        <variable
            name="messageClickListener"
            type="View.OnClickListener" />
        <variable
            name="replyClickListener"
            type="View.OnClickListener" />
        <variable
            name="blockClickListener"
            type="View.OnClickListener" />
        <variable
            name="showBlock"
            type="Boolean" />
        <variable
            name="isBlocked"
            type="Boolean" />
        <variable
            name="showMessage"
            type="Boolean" />
        <variable
            name="showReply"
            type="Boolean" />
        <variable
            name="contactExists"
            type="Boolean" />
        <variable
            name="disableAddContact"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sk_menu_frame"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sk_call"
            android:onClick="@{callClickListener}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sk_menu_call_back"
            style="@style/context_menu_action_label_style"
            android:drawableStart="@drawable/phone"
            skMenuRole="@{`call`}"
            app:layout_constraintBottom_toTopOf="@id/sk_message"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sk_message"
            android:onClick="@{messageClickListener}"
            android:visibility="@{showMessage ? View.VISIBLE : View.GONE}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sk_menu_message"
            style="@style/context_menu_action_label_style"
            android:drawableStart="@drawable/sk_message_outline"
            skMenuRole="@{`message`}"
            app:layout_constraintBottom_toTopOf="@id/sk_reply"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sk_reply"
            android:onClick="@{replyClickListener}"
            android:visibility="@{showReply ? View.VISIBLE : View.GONE}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sk_menu_written_reply"
            style="@style/context_menu_action_label_style"
            android:drawableStart="@drawable/sk_message_outline"
            skMenuRole="@{`message`}"
            app:layout_constraintBottom_toTopOf="@id/sk_divider_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- shiroikuma fork: the line between two groups of the menu. -->
        <View
            android:id="@+id/sk_divider_1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/sk_menu_divider"
            app:layout_constraintBottom_toTopOf="@id/add_to_contact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/add_to_contact"
            android:onClick="@{addToContactsListener}"
            android:visibility="@{contactExists || disableAddContact ? View.GONE : View.VISIBLE}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/menu_add_address_to_contacts"
            style="@style/context_menu_action_label_style"
            android:background="@drawable/menu_item_background"
            android:layout_marginBottom="1dp"
            android:drawableStart="@drawable/user_plus"
            skMenuRole="@{`contact`}"
            skMenuOpens="@{true}"
            app:layout_constraintBottom_toTopOf="@id/go_to_contact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/go_to_contact"
            android:onClick="@{goToContactClickListener}"
            android:visibility="@{contactExists ? View.VISIBLE : View.GONE}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/menu_see_existing_contact"
            style="@style/context_menu_action_label_style"
            android:background="@drawable/menu_item_background"
            android:layout_marginBottom="1dp"
            android:drawableStart="@drawable/user_circle"
            skMenuRole="@{`contact`}"
            skMenuOpens="@{true}"
            app:layout_constraintBottom_toTopOf="@id/share"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/share"
            android:onClick="@{copyNumberClickListener}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/menu_copy_sip_address"
            style="@style/context_menu_action_label_style"
            android:background="@drawable/menu_item_background"
            android:layout_marginBottom="1dp"
            android:drawableStart="@drawable/copy"
            skMenuRole="@{`share`}"
            app:layout_constraintBottom_toTopOf="@id/sk_divider_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- shiroikuma fork: the line between two groups of the menu. -->
        <View
            android:id="@+id/sk_divider_2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/sk_menu_divider"
            app:layout_constraintBottom_toTopOf="@id/sk_block"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- shiroikuma fork: into the blocked numbers, or out of them again (SkBlocked). -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sk_block"
            android:onClick="@{blockClickListener}"
            android:visibility="@{showBlock ? View.VISIBLE : View.GONE}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{isBlocked ? @string/sk_menu_unblock_number : @string/sk_menu_block_number, default=@string/sk_menu_block_number}"
            style="@style/context_menu_action_label_style"
            android:drawableStart="@drawable/sk_prohibit"
            skMenuRole="@{`block`}"
            app:layout_constraintBottom_toTopOf="@id/delete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/delete"
            android:onClick="@{deleteClickListener}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/menu_delete_selected_item"
            style="@style/context_menu_danger_action_label_style"
            android:background="@drawable/menu_item_background"
            android:layout_marginBottom="1dp"
            android:drawableStart="@drawable/trash_simple"
            skMenuRole="@{`delete`}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>