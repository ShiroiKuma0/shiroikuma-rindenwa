<?xml version="1.0" encoding="utf-8"?>
<!-- A top-level section of the 臨電話 UI page, and it folds: the full-width 1px line that sets it
     apart from the section above (kept whether folded or open), the big bold heading with its
     TEXT-WIDE underline — a match_parent View inside a wrap_content wrapper — and a › (folded) or
     ⌄ (open) at the right; a tap on the heading folds or unfolds the rows in sk_section_body. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">
    <View
        android:id="@+id/sk_section_spacer"
        android:layout_width="match_parent"
        android:layout_height="1px" />
    <LinearLayout
        android:id="@+id/sk_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="36dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/sk_section_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />
            <View
                android:id="@+id/sk_section_rule"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/sk_section_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:includeFontPadding="false"
            android:textSize="24sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sk_section_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
