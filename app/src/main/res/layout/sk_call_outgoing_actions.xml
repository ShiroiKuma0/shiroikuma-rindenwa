<?xml version="1.0" encoding="utf-8"?>
<!--
  shiroikuma-rindenwa fork — the outgoing-call controls, in the same geometry as the incoming-call
  panel (sk_call_incoming_actions.xml), so a call looks like one screen whichever way it started.

  Upstream's bar was a grey sheet with a drag handle that could not be dragged, a red squircle at
  the left edge, a video button that was never enabled, and the keypad floating above it as a
  separate button. This panel keeps what a ringing call can actually use:

    · the top row changes how the call sounds and never ends it — Mute, the audio output, and the
      keypad. They are black circles with a yellow ring; a control that is on changes its icon and
      its label, never its fill.
    · the bottom row is the decision — red Hang up, alone and centred.

  The audio output and the keypad need a media stream, so they are dimmed until the other end
  answers with one. The audio output is live while the call rings *or* plays early media: upstream
  enabled it for `180 Ringing` only, and a provider that answers `183 Session Progress` — Odorik
  does, on every call — never left that state, so the loudspeaker could not be switched on until
  the call was picked up.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="org.linphone.ui.call.viewmodel.CurrentCallViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/sk_call_actions_vertical_padding"
        android:paddingBottom="@dimen/sk_call_actions_vertical_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="@dimen/sk_call_action_column_width"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/toggle_mute_mic"
                    android:layout_width="@dimen/sk_call_round_button_size"
                    android:layout_height="@dimen/sk_call_round_button_size"
                    android:background="@drawable/sk_round_outlined_button"
                    android:onClick="@{() -> viewModel.toggleMuteMicrophone()}"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/sk_call_round_button_padding"
                    android:scaleType="fitCenter"
                    android:src="@{viewModel.isMicrophoneMuted ? @drawable/microphone_slash : @drawable/microphone, default=@drawable/microphone}"
                    android:contentDescription="@string/content_description_toggle_microphone"
                    app:tint="@color/sk_yellow" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/default_text_style_700"
                    android:id="@+id/toggle_mute_mic_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@{viewModel.isMicrophoneMuted ? @string/sk_call_muted : @string/sk_call_mute, default=@string/sk_call_mute}"
                    android:textColor="@color/sk_yellow"
                    android:textSize="@dimen/sk_call_action_label_size" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/sk_call_action_column_width"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:alpha="@{viewModel.isOutgoingRinging || viewModel.isOutgoingEarlyMedia ? 1f : 0.4f}">

                <ImageView
                    android:id="@+id/change_audio_output"
                    android:layout_width="@dimen/sk_call_round_button_size"
                    android:layout_height="@dimen/sk_call_round_button_size"
                    android:background="@drawable/sk_round_outlined_button"
                    android:onClick="@{() -> viewModel.changeAudioOutputDevice()}"
                    android:clickable="@{viewModel.isOutgoingRinging || viewModel.isOutgoingEarlyMedia}"
                    android:focusable="true"
                    android:padding="@dimen/sk_call_round_button_padding"
                    android:scaleType="fitCenter"
                    android:src="@{viewModel.isHeadsetEnabled ? @drawable/headset : viewModel.isBluetoothEnabled ? @drawable/bluetooth : viewModel.isSpeakerEnabled ? @drawable/speaker_high : @drawable/speaker_slash, default=@drawable/speaker_slash}"
                    android:contentDescription="@string/content_description_change_output_audio_device"
                    app:tint="@color/sk_yellow" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/default_text_style_700"
                    android:id="@+id/change_audio_output_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@{viewModel.isHeadsetEnabled ? @string/sk_call_output_headset : viewModel.isBluetoothEnabled ? @string/sk_call_output_bluetooth : @string/sk_call_output_speaker, default=@string/sk_call_output_speaker}"
                    android:textColor="@color/sk_yellow"
                    android:textSize="@dimen/sk_call_action_label_size" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/sk_call_action_column_width"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:alpha="@{viewModel.isOutgoingEarlyMedia ? 1f : 0.4f}">

                <ImageView
                    android:id="@+id/show_numpad"
                    android:layout_width="@dimen/sk_call_round_button_size"
                    android:layout_height="@dimen/sk_call_round_button_size"
                    android:background="@drawable/sk_round_outlined_button"
                    android:onClick="@{() -> viewModel.showNumpad()}"
                    android:clickable="@{viewModel.isOutgoingEarlyMedia}"
                    android:focusable="true"
                    android:padding="@dimen/sk_call_round_button_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/numpad"
                    android:contentDescription="@string/content_description_show_numpad"
                    app:tint="@color/sk_yellow" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/default_text_style_700"
                    android:id="@+id/show_numpad_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/sk_call_keypad"
                    android:textColor="@color/sk_yellow"
                    android:textSize="@dimen/sk_call_action_label_size" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/hang_up"
            android:layout_width="@dimen/sk_call_round_button_size"
            android:layout_height="@dimen/sk_call_round_button_size"
            android:layout_marginTop="@dimen/sk_call_actions_row_gap"
            android:background="@drawable/sk_round_danger_button"
            android:onClick="@{() -> viewModel.hangUp()}"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/sk_call_round_button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/phone_disconnect"
            android:contentDescription="@string/content_description_hang_up_call"
            app:tint="@color/bc_white" />

    </LinearLayout>

</layout>
