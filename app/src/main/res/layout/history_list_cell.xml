<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="model"
            type="org.linphone.ui.main.history.model.CallLogModel" />
        <variable
            name="onClickListener"
            type="View.OnClickListener" />
        <variable
            name="onLongClickListener"
            type="View.OnLongClickListener" />
        <variable
            name="onCallClickListener"
            type="View.OnClickListener" />
        <variable
            name="onMessageClickListener"
            type="View.OnClickListener" />
        <variable
            name="onMenuClickListener"
            type="View.OnClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:onClick="@{onClickListener}"
        android:onLongClickListener="@{onLongClickListener}"
        android:onContextClick="@{onLongClickListener}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/primary_cell_background">

        <include
            android:id="@+id/avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            layout="@layout/contact_avatar"
            bind:model="@{model.avatarModel}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style"
            android:id="@+id/call_log_display_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@{model.avatarModel.name, default=`John Doe`}"
            android:textSize="14sp"
            android:textColor="?attr/color_main2_800"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/number_label"/>

        <!-- shiroikuma fork: which of the contact's numbers this call used, and the address-book
             field it is filed under. Gone when there is nothing to add beyond the name. -->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_300"
            android:id="@+id/number_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@{model.numberWithLabel, default=`+420-601-524-009 · Home`}"
            android:textSize="14sp"
            android:textColor="?attr/color_main2_600"
            android:visibility="@{model.numberWithLabel.empty ? View.INVISIBLE : View.VISIBLE}"
            app:layout_constraintStart_toStartOf="@id/call_log_display_name"
            app:layout_constraintEnd_toStartOf="@id/call"
            app:layout_constraintTop_toBottomOf="@id/call_log_display_name"
            app:layout_constraintBottom_toTopOf="@id/date_time"/>

        <!-- shiroikuma fork: 臨N — which SIP account the call went through. The same place the
             sister dialer puts its red 1 / blue 2 SIM mark. -->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_700"
            android:id="@+id/sk_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@{model.skBadge, default=`臨1`}"
            android:textSize="11sp"
            android:textColor="@color/sk_badge_rin_text"
            android:background="@drawable/sk_badge_rin"
            app:layout_constraintStart_toStartOf="@id/call_log_display_name"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time" />

        <ImageView
            android:id="@+id/call_status"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="4dp"
            android:src="@{model.skArrowRes, default=@drawable/sk_call_made}"
            android:contentDescription="@null"
            android:layout_marginStart="4dp"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintStart_toEndOf="@id/sk_badge"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_300"
            android:id="@+id/date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="@{model.dateTime, default=`午後八時四十七分`}"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/call_status"
            app:layout_constraintTop_toBottomOf="@id/number_label"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- shiroikuma fork: how long the call lasted, written after its time exactly as the
             sister dialer writes it — a dot, then the duration. Both go when there is nothing to
             report (a call that never connected, or the duration turned off on the UI page). -->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_300"
            android:id="@+id/duration_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="@string/sk_call_duration_separator"
            android:textSize="12sp"
            android:visibility="@{model.duration.empty ? View.GONE : View.VISIBLE}"
            app:layout_constraintStart_toEndOf="@id/date_time"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_300"
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@{model.duration, default=`（十一分一秒）`}"
            android:textSize="12sp"
            android:visibility="@{model.duration.empty ? View.GONE : View.VISIBLE}"
            app:layout_constraintStart_toEndOf="@id/duration_separator"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time"/>

        <!-- shiroikuma fork: why a call that was placed never connected — busy, declined, not
             answered. It stands where the duration would, since such a call has none. -->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_300"
            android:id="@+id/sk_failure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:text="@{model.skFailure, default=`話し中`}"
            android:textSize="12sp"
            android:textColor="@color/sk_ink_dim"
            android:visibility="@{model.skFailure.empty ? View.GONE : View.VISIBLE}"
            app:layout_constraintStart_toEndOf="@id/duration"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time"/>

        <!-- shiroikuma fork: this call was a callback ordered here (SkOdorikCallback). Said in
             a word, beside the arrow that already has its own shape: a 12 dp glyph here went
             unseen (白い熊, 2026-11-17). -->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_700"
            android:id="@+id/sk_callback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="@string/sk_callback_menu_callback"
            android:textSize="13sp"
            android:textColor="@color/sk_yellow"
            android:visibility="@{model.skIsCallback ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintStart_toEndOf="@id/sk_failure"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time" />

        <ImageView
            android:id="@+id/sk_recorded"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/record_fill"
            android:contentDescription="@string/sk_content_description_recorded"
            android:visibility="@{model.skRecorded ? View.VISIBLE : View.GONE, default=gone}"
            app:tint="@color/sk_recorded"
            app:layout_constraintStart_toEndOf="@id/sk_callback"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time" />

        <!-- shiroikuma fork: the country the number belongs to, at the right end of the last
             line as in the sister dialer. -->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_300"
            android:id="@+id/sk_country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:text="@{model.skCountry, default=`チェコ`}"
            android:textSize="12sp"
            android:textColor="@color/sk_ink_dim"
            android:visibility="@{model.skCountry.empty ? View.GONE : View.VISIBLE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/date_time"
            app:layout_constraintBottom_toBottomOf="@id/date_time"/>

        <!-- shiroikuma fork: the three things a row offers at its right end, in the order the
             sister dialer has them — call it back through the account this row's call used (a
             long hold asks: callback or call), write to this number (opens the messenger), and
             the row's own menu. The handset comes first (白い熊, 2026-11-17). A row with no
             number to write to keeps the bubble's place empty, so the handsets stay in one
             column.

             They sit on the second line only, each as tall as that line with nothing around it
             (白い熊, 2026-11-17, after seeing the row folded): spanning the first two lines they
             cut the name down to a few letters on the narrow screen. So the name runs the full
             width, the number ends where the bubble begins, and the third line runs under them
             to the edge. The ⋮ box is half as wide as it is tall and cropped to its dots, which
             is what makes the three gaps look equal. The bubble is the outlined one, in the
             accent; the sister dialer's style may recolour it and the handset. -->
        <ImageView
            android:onClick="@{onCallClickListener}"
            android:id="@+id/call"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="0dp"
            android:layout_marginEnd="28dp"
            android:src="@drawable/phone"
            android:background="@drawable/circle_transparent_button_background"
            android:contentDescription="@string/content_description_call_start"
            android:visibility="@{model.wasConference ? View.GONE : View.VISIBLE}"
            app:tint="@color/sk_role_call"
            app:layout_constraintEnd_toStartOf="@id/message"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintTop_toTopOf="@id/number_label"
            app:layout_constraintBottom_toBottomOf="@id/number_label" />

        <ImageView
            android:onClick="@{onMessageClickListener}"
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="0dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/sk_message_outline"
            android:background="@drawable/circle_transparent_button_background"
            android:contentDescription="@string/sk_content_description_message"
            android:visibility="@{model.skPhoneNumber.empty || model.wasConference ? View.INVISIBLE : View.VISIBLE}"
            app:tint="@color/sk_yellow"
            app:layout_constraintEnd_toStartOf="@id/row_menu"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintTop_toTopOf="@id/number_label"
            app:layout_constraintBottom_toBottomOf="@id/number_label" />

        <ImageView
            android:onClick="@{onMenuClickListener}"
            android:id="@+id/row_menu"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dots_three_vertical"
            android:background="@drawable/circle_transparent_button_background"
            android:contentDescription="@string/sk_content_description_row_menu"
            app:tint="?attr/color_main2_500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="W,1:2"
            app:layout_constraintTop_toTopOf="@id/number_label"
            app:layout_constraintBottom_toBottomOf="@id/number_label" />

        <!-- shiroikuma fork: the thin, pale line between two calls of one day (白い熊,
             2026-11-17). It stops short of both edges — the row's own padding — so it reads as
             lighter than the day's line, which runs the full width; and the last call of a day
             has none, the day's line being right there. Thickness and colour are the sister
             dialer's (thickness.divider, color.divider), so both histories carry the same line. -->
        <View
            android:id="@+id/separator"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?attr/color_separator"
            android:visibility="gone"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>