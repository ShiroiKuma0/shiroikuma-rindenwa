<?xml version="1.0" encoding="utf-8"?>
<!--
  shiroikuma-rindenwa fork — who a call is with, in the address book's two cards (白い熊,
  2026-11-26): the picture card and the name card (sk_call_party_text.xml), side by side on a wide screen (two panels and wider).
  This file and its twin in layout differ in nothing but that arrangement.

  The picture is shown whole — fitted into its card, never cropped and never round, whatever its
  shape. Only a caller without a picture gets the round stand-in, in the middle of the card.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="org.linphone.ui.call.viewmodel.CurrentCallViewModel" />
        <variable
            name="showStatus"
            type="Boolean" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/sk_picture_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="6dp"
            android:background="@drawable/sk_call_card">

            <FrameLayout
                android:layout_width="@dimen/avatar_in_call_size"
                android:layout_height="@dimen/avatar_in_call_size"
                android:layout_gravity="center"
                android:tag="sk_picture_fallback">

                <include
                    android:id="@+id/sk_avatar"
                    layout="@layout/contact_avatar_huge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:model="@{viewModel.contact}" />

            </FrameLayout>

            <ImageView
                android:id="@+id/sk_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="invisible"
                skWholePicture="@{viewModel.contact.picturePath}" />

        </FrameLayout>

        <include
            android:id="@+id/sk_text"
            layout="@layout/sk_call_party_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:viewModel="@{viewModel}"
            app:showStatus="@{showStatus}" />

    </LinearLayout>

</layout>
